<idea-plugin>
    <id>de.suprexdev.subwaycoders</id>
    <name>Subway Coders</name>
    <vendor email="mail@suprex.dev" url="https://suprex.dev">SuprexDE</vendor>

    <description><![CDATA[Looping <b>Subway Surfers</b>, Temple Run, Minecraft and other "brain-rot" clips in
      tool windows right inside your IDE.
      <ul>
        <li>Four independent players, one per screen edge</li>
        <li>Config-driven categories; YouTube links or direct video URLs</li>
        <li><b>Doomscroll mode</b> for the YouTube Shorts feed</li>
        <li>Pauses when hidden; fades out and focuses the Terminal while Claude Code waits for you,
          and comes back when you reply</li>
        <li>Status bar widget with today's watch time</li>
      </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Subway Coders (Left)" anchor="left" icon="/icons/subway-coder-left.svg"
                    factoryClass="dev.suprex.subwaycoders.ui.SubwayCodersToolWindowFactory"/>
        <toolWindow id="Subway Coders (Right)" anchor="right" icon="/icons/subway-coder-right.svg"
                    factoryClass="dev.suprex.subwaycoders.ui.SubwayCodersToolWindowFactory"/>
        <toolWindow id="Subway Coders (Top)" anchor="top" icon="/icons/subway-coder-top.svg"
                    factoryClass="dev.suprex.subwaycoders.ui.SubwayCodersToolWindowFactory"/>
        <toolWindow id="Subway Coders (Bottom)" anchor="bottom" icon="/icons/subway-coder-bottom.svg"
                    factoryClass="dev.suprex.subwaycoders.ui.SubwayCodersToolWindowFactory"/>
        <postStartupActivity implementation="dev.suprex.subwaycoders.claude.ClaudeNotifyStartup"/>
        <notificationGroup id="Subway Coders" displayType="BALLOON"/>
        <statusBarWidgetFactory id="SubwayCodersWatchTime"
                                implementation="dev.suprex.subwaycoders.stats.WatchTimeWidgetFactory"/>
    </extensions>
</idea-plugin>
